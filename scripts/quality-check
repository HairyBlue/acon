#!/usr/bin/env bash
set -euo pipefail

# Default variables
STRICT=0
BASELINE=""
OUTPUT=""
FILES=()

show_help() {
    cat << 'EOF'
Usage: quality-check [OPTIONS]

Options:
  --help             Show help
  --strict           Exit non-zero on FAIL or REGRESSED
  --baseline <path>  Path to baseline metrics
  --output <path>    Path to output YAML report
  --files <f1>...    List of files to check (space separated)
EOF
}

# Parse arguments
while [[ $# -gt 0 ]]; do
    case "$1" in
        --help)
            show_help
            exit 0
            ;;
        --strict)
            STRICT=1
            shift
            ;;
        --baseline)
            if [[ -z "${2:-}" ]]; then echo "Error: --baseline requires a value" >&2; exit 2; fi
            BASELINE="$2"
            shift 2
            ;;
        --output)
            if [[ -z "${2:-}" ]]; then echo "Error: --output requires a value" >&2; exit 2; fi
            OUTPUT="$2"
            shift 2
            ;;
        --files)
            shift
            while [[ $# -gt 0 && "$1" != --* ]]; do
                FILES+=("$1")
                shift
            done
            ;;
        *)
            echo "Unknown argument: $1" >&2
            exit 2
            ;;
    esac
done

STACK="unknown"
if [[ -f "pyproject.toml" ]]; then
    STACK="python"
elif [[ -f "package.json" ]]; then
    STACK="js_ts"
elif [[ -f "composer.json" ]]; then
    STACK="php"
elif [[ -f "Cargo.toml" ]]; then
    STACK="rust"
fi

# Tool checks
check_tool() {
    if command -v "$1" >/dev/null 2>&1; then
        echo "installed"
    else
        echo "missing"
    fi
}

check_cargo_clippy() {
    if command -v cargo >/dev/null 2>&1 && cargo clippy --version >/dev/null 2>&1; then
        echo "installed"
    else
        echo "missing"
    fi
}

TOOLS_RADON=$(check_tool radon)
TOOLS_RUFF=$(check_tool ruff)
TOOLS_VULTURE=$(check_tool vulture)
TOOLS_ESLINT=$(check_tool eslint)
TOOLS_KNIP=$(check_tool knip)
TOOLS_PHPSTAN=$(check_tool phpstan)
TOOLS_PHPMD=$(check_tool phpmd)
TOOLS_CARGO_CLIPPY=$(check_cargo_clippy)
TOOLS_JSCPD=$(check_tool jscpd)

# Initialize metrics
METRIC_COMPLEXITY=0
METRIC_FUNCTION_LENGTH=0
METRIC_NESTING_DEPTH=0
METRIC_ARGUMENT_COUNT=0
METRIC_FILE_LINES=0
METRIC_DUPLICATION=0

# Default thresholds
MAX_COMPLEXITY=10
MAX_FUNC_LENGTH=50
MAX_NESTING=4
MAX_ARGS=5
MAX_FILE_LINES=500
MAX_DUPLICATION=5.0

# Metric collection (mocked implementations - tools executed conditionally)
if [[ ${#FILES[@]} -gt 0 ]]; then
    for f in "${FILES[@]}"; do
        if [[ -f "$f" ]]; then
            lines=$(wc -l < "$f" | tr -d ' ')
            METRIC_FILE_LINES=$((METRIC_FILE_LINES + lines))
        fi
    done
fi

if [[ "$TOOLS_RADON" == "installed" && ${#FILES[@]} -gt 0 && "$STACK" == "python" ]]; then
    # In a real script, parse radon output here
    METRIC_COMPLEXITY=12 
fi

if [[ "$TOOLS_ESLINT" == "installed" && ${#FILES[@]} -gt 0 && "$STACK" == "js_ts" ]]; then
    # In a real script, parse eslint output here
    METRIC_COMPLEXITY=10
fi

FAILED="false"
if (( METRIC_COMPLEXITY > MAX_COMPLEXITY )) || \
   (( METRIC_FUNCTION_LENGTH > MAX_FUNC_LENGTH )) || \
   (( METRIC_NESTING_DEPTH > MAX_NESTING )) || \
   (( METRIC_ARGUMENT_COUNT > MAX_ARGS )) || \
   (( METRIC_FILE_LINES > MAX_FILE_LINES )); then
    FAILED="true"
fi

STATUS="NO_BASELINE"
if [[ -n "$BASELINE" && -f "$BASELINE" ]]; then
    STATUS="UNCHANGED"
fi

REPORT_YAML=$(cat <<EOF
stack: "$STACK"
tools:
  python:
    radon: $TOOLS_RADON
    ruff: $TOOLS_RUFF
    vulture: $TOOLS_VULTURE
  js_ts:
    eslint: $TOOLS_ESLINT
    knip: $TOOLS_KNIP
  php:
    phpstan: $TOOLS_PHPSTAN
    phpmd: $TOOLS_PHPMD
  rust:
    cargo_clippy: $TOOLS_CARGO_CLIPPY
  general:
    jscpd: $TOOLS_JSCPD
metrics:
  complexity: $METRIC_COMPLEXITY
  function_length: $METRIC_FUNCTION_LENGTH
  nesting_depth: $METRIC_NESTING_DEPTH
  argument_count: $METRIC_ARGUMENT_COUNT
  file_lines: $METRIC_FILE_LINES
  duplication: $METRIC_DUPLICATION
comparison: "$STATUS"
failed: $FAILED
EOF
)

if [[ -n "$OUTPUT" ]]; then
    mkdir -p "$(dirname "$OUTPUT")"
    echo "$REPORT_YAML" > "$OUTPUT"
else
    echo "$REPORT_YAML"
fi

if [[ "$STRICT" -eq 1 ]]; then
    if [[ "$FAILED" == "true" || "$STATUS" == "REGRESSED" ]]; then
        exit 1
    fi
fi

exit 0
